// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  eventType   String
  eventDate   DateTime?
  guestCount  Int?
  location    String?
  message     String
  status      String    @default("NEW") // NEW, CONTACTED, CONFIRMED, COMPLETED
  createdAt   DateTime  @default(now())
}

model Event {
  id          String    @id @default(cuid())
  name        String
  category    String
  location    String
  date        DateTime?
  description String
  coverImage  String
  createdAt   DateTime  @default(now())
}
